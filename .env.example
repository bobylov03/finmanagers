# Скопируйте в .env и при необходимости измените
PORT=8000
# Путь к базе вне Docker (по умолчанию data/wallets.sqlite3)
# WALLETS_DB=data/wallets.sqlite3
# 1 — если приложение открывается по HTTPS (через nginx и т. п.)
COOKIE_SECURE=0
# Через сколько часов бездействия нужно войти заново
SESSION_IDLE_HOURS=12
# Рассылка уведомлений (необязательно). Без SMTP_HOST письма не отправляются.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Час, после которого сервер отправляет ежедневные уведомления
NOTIFY_HOUR=19
